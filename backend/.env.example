# Copie para backend/.env. O runner PowerShell carrega este arquivo.
# SQLite persistente padrão: backend/data/apresentacao.db (caminho absoluto no código).
# Opcional: DATABASE_URL=sqlite:///C:/caminho/privado/apresentacao.db
APP_ENV=development
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
BOOKING_HOLD_MINUTES=30
# Preserve a chave backend/secrets/data-encryption.key junto aos backups privados.
# DATA_ENCRYPTION_KEY_FILE=C:/caminho/privado/data-encryption.key
# Firebase Admin opcional; por padrão usa backend/data/firebase-admin.json se existir.
# GOOGLE_APPLICATION_CREDENTIALS=C:/caminho/privado/firebase-admin.json
# Email é opcional na apresentação; sem SMTP não há envio real de recuperação.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
APP_CONTACT_EMAIL=
